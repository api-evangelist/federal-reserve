{
  "opencollection": "1.0.0",
  "info": {
    "name": "Federal Reserve FRED Category Series API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Series",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a series",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.stlouisfed.org/fred/series",
            "params": [
              {
                "name": "series_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get a series"
        },
        {
          "info": {
            "name": "Get observations for a series",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.stlouisfed.org/fred/series/observations",
            "params": [
              {
                "name": "series_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "observation_start",
                "value": "",
                "type": "query"
              },
              {
                "name": "observation_end",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get observations for a series"
        },
        {
          "info": {
            "name": "Search series by text",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.stlouisfed.org/fred/series/search",
            "params": [
              {
                "name": "search_text",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search series by text"
        }
      ]
    }
  ],
  "bundled": true
}