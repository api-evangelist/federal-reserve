{
  "opencollection": "1.0.0",
  "info": {
    "name": "Federal Reserve FRED Category Tags API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.stlouisfed.org/fred/tags"
          },
          "docs": "Get all tags"
        }
      ]
    }
  ],
  "bundled": true
}